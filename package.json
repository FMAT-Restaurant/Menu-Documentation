{
  "name": "fmat-restaurant-specification",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint:mermaid": "node tools/validate-mermaid.mjs",
    "api:serve": "redocly preview output/contracts/api/openapi.yaml",
