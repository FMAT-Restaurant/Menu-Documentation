    "api:lint.generate.ignore.file": "redocly lint output/contracts/api/openapi.yaml --generate-ignore-file",
    "api:docs": "redocly build-docs output/contracts/api/openapi.yaml"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "mermaid": "12.0.0"
  }
}
