{
  "name": "fmat-restaurant-specification",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint:mermaid": "node tools/validate-mermaid.mjs",
    "api:serve": "redocly preview docs/apis/menu/openapi.yaml",
    "api:lint": "redocly lint docs/apis/menu/openapi.yaml",
    "api:lint.generate.ignore.file": "redocly lint docs/apis/menu/openapi.yaml --generate-ignore-file",
    "api:bundle": "redocly bundle docs/apis/menu/openapi.yaml --output docs/apis/menu/dist/openapi.yaml --ext yaml",
    "api:docs": "redocly build-docs docs/apis/menu/openapi.yaml",
    "docs:prepare": "pnpm run api:bundle && node tools/prepare-documentation-site.mjs",
    "docs:dev": "pnpm run docs:prepare && docusaurus start",
    "docs:build": "pnpm run docs:prepare && docusaurus build"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@redocly/cli": "2.54.2",
    "@scalar/docusaurus": "0.8.44",
    "jsdom": "30.1.1",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
